# One tunnel per instance: vpnd@vpn0 reads /etc/vpnd/vpn0.toml and creates
# interface vpn0.  systemctl enable --now vpnd@vpn0
[Unit]
Description=vpnd tunnel %i
Documentation=https://github.com/JackFurton/vpn/blob/main/docs/server-setup.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# systemd reads the root-only config and hands the service a private copy,
# so the service user never needs access to /etc/vpnd.
LoadCredential=config:/etc/vpnd/%i.toml
ExecStart=/usr/local/bin/vpnd up -c ${CREDENTIALS_DIRECTORY}/config -i %i
Restart=on-failure
RestartSec=2s

# A throwaway uid that exists only while the service runs, holding only the
# capability needed to create the TUN device. vpnd drops even that once the
# tunnel is up.
DynamicUser=yes
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes

DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
# netlink to configure the interface, unix for the journal.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

[Install]
WantedBy=multi-user.target
