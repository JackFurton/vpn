# One tunnel per instance: vpnd@vpn0 reads /etc/vpnd/vpn0.toml and creates
# interface vpn0.  systemctl enable --now vpnd@vpn0
[Unit]
Description=vpnd tunnel %i
Documentation=https://github.com/JackFurton/vpn/blob/main/docs/server-setup.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# systemd reads the root-only config and hands the service a private copy,
# so the service user never needs access to /etc/vpnd.
LoadCredential=config:/etc/vpnd/%i.toml
ExecStart=/usr/local/bin/vpnd up -c ${CREDENTIALS_DIRECTORY}/config -i %i --user vpnd
# systemctl reload doesn't refresh the credential, so this reads the file
# itself (as root) and hands it to the daemon's control socket.
ExecReload=/usr/local/bin/vpnd reload -c /etc/vpnd/%i.toml -i %i
# For the control socket. Shared by every instance, so stopping one mustn't
# delete it.
RuntimeDirectory=vpnd
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=2s

# Starts as root, because systemd-resolved only takes DNS settings from uid
# 0 (CAP_NET_ADMIN isn't enough), but with every capability gone except the
# three setup needs: create the TUN device, then switch users. Once the
# tunnel is up vpnd becomes the vpnd user (packaging/sysusers.d) and drops
# even those.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID
NoNewPrivileges=yes

DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
# netlink to configure the interface, unix for the journal.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

[Install]
WantedBy=multi-user.target
